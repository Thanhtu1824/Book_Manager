@model QuanLiSach.Models.Book

@{
    ViewData["Title"] = "Thêm sách mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4" style="max-width: 800px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Thêm sách mới</h4>
        </div>
        <div class="card-body">
            <form asp-action="Add" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Id" class="form-label fw-bold">Mã sách (ID)</label>
                        <input asp-for="Id" class="form-control" placeholder="Nhập ID..." />
                        <span asp-validation-for="Id" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label fw-bold">Tên sách</label>
                        <input asp-for="Title" class="form-control" placeholder="Nhập tên sách..." />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Author" class="form-label fw-bold">Tác giả</label>
                        <input asp-for="Author" class="form-control" placeholder="Nhập tác giả..." />
                        <span asp-validation-for="Author" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Publisher" class="form-label fw-bold">Nhà xuất bản</label>
                        <input asp-for="Publisher" class="form-control" placeholder="Nhập NXB..." />
                        <span asp-validation-for="Publisher" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Year" class="form-label fw-bold">Năm xuất bản</label>
                        <input asp-for="Year" class="form-control" type="number" placeholder="Ví dụ: 2024" />
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ)</label>
                        <input asp-for="Price" class="form-control" type="number" step="1000" placeholder="Nhập giá bán..." />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Cover" class="form-label fw-bold">Ảnh bìa sách</label>
                        <input asp-for="Cover" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="Cover" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-bold">Mô tả nội dung</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả tóm tắt..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                    <button type="submit" class="btn btn-primary px-4">Tạo mới</button>
                </div>
            </form>
        </div>
    </div>
</div>