@model QuanLiSach.Models.Book

@{
    ViewData["Title"] = "Cập nhật sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4" style="max-width: 800px;">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Cập nhật thông tin sách</h4>
        </div>
        <div class="card-body">
            <form asp-action="Update" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Id" class="form-label fw-bold">Mã sách (ID)</label>
                        <input asp-for="Id" class="form-control bg-light" readonly />
                        <span asp-validation-for="Id" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label fw-bold">Tên sách</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-bold">Thể loại</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" required>
                            <option value="">-- Chọn thể loại --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Author" class="form-label fw-bold">Tác giả</label>
                        <input asp-for="Author" class="form-control" />
                        <span asp-validation-for="Author" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Publisher" class="form-label fw-bold">Nhà xuất bản</label>
                        <input asp-for="Publisher" class="form-control" />
                        <span asp-validation-for="Publisher" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Year" class="form-label fw-bold">Năm xuất bản</label>
                        <input asp-for="Year" class="form-control" type="number" />
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ)</label>
                        <input asp-for="Price" class="form-control" type="number" step="1000" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <!-- 1. Thẻ ẩn giữ lại tên file ảnh cũ -->
                    <input type="hidden" asp-for="Cover" />

                    <div class="col-12">
                        <label class="form-label fw-bold">Ảnh bìa hiện tại</label>
                        <div class="mb-2">
                            <img src="~/images/@(string.IsNullOrEmpty(Model.Cover) ? "default-book.png" : Model.Cover)"
                                 class="img-thumbnail"
                                 style="width: 100px; height: 130px; object-fit: cover;"
                                 alt="@Model.Title" />
                        </div>

                        <label class="form-label fw-bold">Thay đổi ảnh bìa (nếu có)</label>
                        <!-- 2. Đặt name="coverFile" dạng file tùy chọn (không gán asp-for trực tiếp vào Cover) -->
                        <input type="file" name="coverFile" class="form-control" accept="image/*" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-bold">Mô tả nội dung</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                    <button type="submit" class="btn btn-warning px-4 fw-bold">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>