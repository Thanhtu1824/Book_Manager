@using System.Collections
@model IEnumerable<QuanLiSach.Models.Book>
@{
    ViewData["Title"] = "Danh sách sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách sách</h2>
        <div>
            <a asp-action="Add" class="btn btn-primary">Thêm sách mới</a>
            <a asp-controller="Category" asp-action="Index" class="btn btn-secondary">Quản lý danh mục</a>
        </div>
    </div>

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Hình ảnh</th>
                <th>Tên sách</th>
                <th>Thể loại</th>
                <th>Tác giả</th>
                <th>Nhà xuất bản</th>
                <th>Giá bán</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>
                        <img src="~/images/@(string.IsNullOrEmpty(book.Cover) ? "default-book.png" : book.Cover)"
                             alt="@book.Title" width="80" class="img-thumbnail" />
                    </td>
                    <td><strong>@book.Title</strong></td>
                    <td>
                        <span class="badge bg-info text-dark">@(book.Category?.Name ?? "Chưa phân loại")</span>
                    </td>
                    <td>@book.Author</td>
                    <td>@book.Publisher</td>
                    <td class="text-danger fw-bold">@string.Format("{0:N0} đ", book.Price)</td>
                    <td class="text-center">
                        <a asp-action="Detail" asp-route-id="@book.Id" class="btn btn-sm btn-info">Chi tiết</a>
                        <a asp-action="Update" asp-route-id="@book.Id" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>