@using System.Collections;
@model IEnumerable<QuanLiSach.Models.Book>
@{
    ViewData["Title"] = "Danh sách sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 text-primary m-0">Quản lý sách</h1>
        <a asp-controller="Book" asp-action="Add" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Thêm sách mới
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle text-center m-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" style="width: 5%;">ID</th>
                            <th scope="col" class="text-start" style="width: 20%;">Tên sách</th>
                            <th scope="col" class="text-start" style="width: 15%;">Tác giả</th>
                            <th scope="col" style="width: 15%;">Nhà xuất bản</th>
                            <th scope="col" style="width: 8%;">Năm XB</th>
                            <th scope="col" style="width: 12%;">Ảnh bìa</th>
                            <th scope="col" style="width: 10%;">Giá bán</th>
                            <th scope="col" style="width: 15%;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var book in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@book.Id</td>
                                    <td class="text-start fw-semibold">@book.Title</td>
                                    <td class="text-start">@book.Author</td>
                                    <td>@book.Publisher</td>
                                    <td>@book.Year</td>
                                    <td>
                                        <img src="~/Image/@(string.IsNullOrEmpty(book.Cover) ? "default-book.png" : book.Cover)"
                                             class="img-thumbnail rounded shadow-sm"
                                             style="width: 90px; height: 120px; object-fit: cover;"
                                             alt="@book.Title" />
                                    </td>
                                    <td class="text-danger fw-bold">
                                        @string.Format("{0:N0} đ", book.Price)
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Detail" asp-route-id="@book.Id" class="btn btn-outline-info" title="Chi tiết">Chi tiết</a>
                                            <a asp-action="Update" asp-route-id="@book.Id" class="btn btn-outline-warning" title="Sửa">Sửa</a>
                                            <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-outline-danger" title="Xóa">Xóa</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">Chưa có dữ liệu sách.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>