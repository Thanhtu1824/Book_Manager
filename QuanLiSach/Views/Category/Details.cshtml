@model QuanLiSach.Models.Category

@{
    ViewData["Title"] = "Chi tiết thể loại";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4" style="max-width: 800px;">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Chi tiết thể loại</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3 fw-bold">Mã ID:</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3 fw-bold">Tên thể loại:</dt>
                <dd class="col-sm-9"><strong>@Model.Name</strong></dd>

                <dt class="col-sm-3 fw-bold">Mô tả:</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrEmpty(Model.Description) ? "Không có mô tả." : Model.Description)
                </dd>

                <dt class="col-sm-3 fw-bold">Danh sách sách thuộc thể loại:</dt>
                <dd class="col-sm-9">
                    @if (Model.Books != null && Model.Books.Any())
                    {
                    <ul class="list-group">
                        @foreach (var book in Model.Books)
                            {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@book.Title</span>
                            <span class="badge bg-primary">@string.Format("{0:N0} đ", book.Price)</span>
                        </li>
                            }
                    </ul>
                    }
                    else
                    {
                    <span class="text-muted">Chưa có cuốn sách nào thuộc thể loại này.</span>
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer bg-light d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
            <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning px-4">Chỉnh sửa</a>
        </div>
    </div>
</div>