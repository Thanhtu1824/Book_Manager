@model QuanLiSach.Models.Category

@{
    ViewData["Title"] = "Thêm thể loại mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Thêm thể loại mới</h4>
        </div>
        <div class="card-body">
            <form asp-action="Add" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Tên thể loại</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên thể loại (VD: Văn học, Kinh tế, Trinh thám,...)" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">Lưu thể loại</button>
                </div>
            </form>
        </div>
    </div>
</div>